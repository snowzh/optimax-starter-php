{
  "name": "optimax-web",
  "version": "0.1.0",
  "private": true,
  "description": "Optimax Starter 前端：基于 Ant Design Pro（antd v6 + UmiJS max）",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "dev": "cross-env UMI_ENV=dev MOCK=none max dev",
    "lint": "npm run biome:lint && npm run tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "max openapi",
    "prepare": "max setup",
    "preview": "max preview --port 8000",
    "preview:build": "max build && max preview --port 8000",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none max dev",
    "start:test": "cross-env UMI_ENV=test MOCK=none max dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-out/playwright-report",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "^3.1.14-2",
    "antd": "^6.6.7",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.7",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-helmet": "^6.1.11",
    "@umijs/lint": "^4.7.27",
    "@umijs/max": "^4.7.27",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1",
    "swagger-ui-dist": "^5.34.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
