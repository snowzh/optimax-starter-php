# Optimax Starter · compose 环境样例（复制为 .env 使用；生产必须覆盖标注项）
# 红线：任何密钥不入库不入镜像（DEPLOYMENT.md）

# ---- API 应用 ----
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# 生成：docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=
LOG_LEVEL=debug

# ---- PostgreSQL ----
DB_DATABASE=optimax_starter
DB_USERNAME=optimax
# 生产必须改为强密码
DB_PASSWORD=secret

# ---- 种子初始密码 ----
ADMIN_INITIAL_PASSWORD=admin123
DEMO_INITIAL_PASSWORD=demo123456

# ---- 容器启动开关（apps/api/docker/entrypoint.sh） ----
MIGRATE_ON_START=true
# 联调/E2E 默认开；生产默认关，首启须手动执行一次 db:seed --force
SEED_ON_START=true

# ---- 镜像 tag（compose.prod.yaml 用，发布时以 git SHA 注入） ----
# IMAGE_TAG=

# ---- 生产覆盖（compose.prod.yaml）----
# APP_ENV=production
# APP_URL=https://your-domain
# ADMIN_INITIAL_PASSWORD=必须覆盖
# DEMO_INITIAL_PASSWORD=必须覆盖
